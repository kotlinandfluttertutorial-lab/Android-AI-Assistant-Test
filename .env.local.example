# ============================================================================
# Android AI Assistant — Local Development Environment
# ============================================================================
#
# Setup:
#   1. Copy this file:  cp .env.local.example .env.local
#   2. Fill in the values marked [REQUIRED].
#   3. Start the stack: docker compose -f docker-compose.local.yml up -d
#
# NEVER commit .env.local — it contains real secrets for your local machine.
# This file (.env.local.example) ONLY contains safe placeholder values.
#
# Environment isolation:
#   LOCAL  → .env.local       (this file, developer machine only)
#   STAGE  → GCP Secret Manager  (aiassistant-stage-* secrets)
#   PROD   → GCP Secret Manager  (aiassistant-prod-* secrets)
#
# No backend secret (API keys, DB passwords, JWT secrets) should ever appear
# in the Android APK or in any CI/CD artifact.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (LOCAL PostgreSQL — Docker service "postgres")
# ──────────────────────────────────────────────────────────────────────────────

# Used by FastAPI and Celery when running OUTSIDE Docker (e.g. local venv).
# When running INSIDE Docker, docker-compose.local.yml overrides this with the
# Docker service name: postgresql+asyncpg://aiassistant:...@postgres:5432/...
# [OPTIONAL — overridden by docker-compose.local.yml inside containers]
DATABASE_URL=postgresql+asyncpg://aiassistant:local_dev_password@localhost:5432/aiassistant_local

POSTGRES_USER=aiassistant
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=aiassistant_local


# ──────────────────────────────────────────────────────────────────────────────
# REDIS (LOCAL Redis — Docker service "redis")
# ──────────────────────────────────────────────────────────────────────────────

# For code running outside Docker (venv):
REDIS_URL=redis://redis:6379/0

# For Celery (also overridden inside Docker containers):
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ──────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE (LOCAL MinIO — Docker service "minio")
# ──────────────────────────────────────────────────────────────────────────────

# For code running outside Docker (venv):
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=aiassistant-local

# MinIO console UI credentials (http://localhost:9001):
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123


# ──────────────────────────────────────────────────────────────────────────────
# VECTOR STORE (LOCAL ChromaDB — Docker service "chromadb")
# ──────────────────────────────────────────────────────────────────────────────

# For code running outside Docker (venv):
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false


# ──────────────────────────────────────────────────────────────────────────────
# JWT / AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NEVER reuse this value in Stage or Production.
SECRET_KEY=your_secret_key_here_generate_with_python_secrets_token_hex_32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30


# ──────────────────────────────────────────────────────────────────────────────
# ENCRYPTION (required to start the backend)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] AES-256 key for encrypting API keys stored in the database.
# Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# NEVER reuse this value in Stage or Production.
AES_ENCRYPTION_KEY=your_aes_key_here_generate_with_python_base64_os_urandom_32


# ──────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER API KEYS
# ──────────────────────────────────────────────────────────────────────────────
# These keys are used by the LOCAL Docker backend ONLY.
#
# Each environment uses its own independent Gemini API key:
#   LOCAL      → this file (.env.local) — developer machine only
#   STAGE      → GCP Secret Manager: aiassistant-stage-gemini-api-key
#   PRODUCTION → GCP Secret Manager: aiassistant-prod-gemini-api-key
#
# Why separate keys per environment?
#   • Stage quota exhaustion never affects Production.
#   • A leaked Stage key cannot be used against Production.
#   • API usage and billing are tracked separately per environment.
#
# SECURITY: Never commit .env.local. Never put any key in the Android APK.
#
# To store Stage / Production keys:
#   $env:GEMINI_API_KEY = "AIza..."
#   .\scripts\store-secrets.ps1 -Environment stage -Secret gemini-api-key
#   .\scripts\store-secrets.ps1 -Environment production -Secret gemini-api-key

# [REQUIRED for local backend] Your LOCAL development Gemini API key.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] OpenAI API key — local development only.
OPENAI_API_KEY=

# [OPTIONAL] Anthropic API key — local development only.
ANTHROPIC_API_KEY=

# [OPTIONAL] Local Ollama server (for local open-weight models).
OLLAMA_BASE_URL=http://localhost:11434

GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite


# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT / LOGGING
# ──────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=DEBUG
LLM_LOG_PROMPTS=false

# CORS: allow requests from the local dev server and local web tools.
CORS_ORIGINS=["https://api.handsonandroid.com","http://localhost:3000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["*"]


# ──────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY (LOCAL Prometheus / Loki / Grafana)
# ──────────────────────────────────────────────────────────────────────────────

PROMETHEUS_ENABLED=true

# Loki is running locally — set the push endpoint.
LOKI_URL=http://loki:3100/loki/api/v1/push

OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-assistant-backend-local
# Leave blank for local (no remote OTLP exporter needed).
OTEL_EXPORTER_OTLP_ENDPOINT=


# ──────────────────────────────────────────────────────────────────────────────
# GRAFANA (local dashboards — http://localhost:3000)
# ──────────────────────────────────────────────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_grafana_password


# ──────────────────────────────────────────────────────────────────────────────
# RATE LIMITING / SECURITY HARDENING
# ──────────────────────────────────────────────────────────────────────────────

# Relax rate limits for local development.
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_UNAUTH_REQUESTS_PER_MINUTE=100
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=10
BCRYPT_WORK_FACTOR=10


# ──────────────────────────────────────────────────────────────────────────────
# MISCELLANEOUS
# ──────────────────────────────────────────────────────────────────────────────

MAX_FILE_SIZE_MB=50
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
DP_EPSILON=1.0
LLM_ENABLE_FALLBACK=true
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRY_ATTEMPTS=3
