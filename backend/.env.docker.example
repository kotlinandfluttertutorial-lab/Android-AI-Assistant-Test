# ============================================================================
# Android AI Assistant — Docker Compose environment file
# ============================================================================
#
# Setup (one-time, ~2 minutes):
#   1.  cp backend/.env.docker.example backend/.env.docker
#   2.  Fill in the two [REQUIRED] values (SECRET_KEY, AES_ENCRYPTION_KEY).
#       Generate them with the one-liners shown below each variable.
#   3.  Optionally add a GEMINI_API_KEY for live LLM responses.
#       Leave it blank to run in "stub" mode — all non-LLM features work.
#   4.  docker compose up -d
#   5.  docker compose exec backend alembic upgrade head
#   6.  curl http://localhost:8000/health  →  {"status": "ok"}
#
# Variable isolation:
#   This file is for the LOCAL Docker stack only.
#   Stage / Production use GCP Secret Manager — never copy values from there.
#
# Security:
#   .env.docker is git-ignored.  NEVER commit it.
#   No production secrets are needed to run this stack.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL  (Docker service "postgres")
# ─────────────────────────────────────────────────────────────────────────────
# These values are used both by the postgres container (POSTGRES_* vars) and
# by the backend/celery containers (DATABASE_URL).  docker-compose.yml
# constructs DATABASE_URL from the individual vars — you do not need to set
# DATABASE_URL manually here.

POSTGRES_USER=aiassistant
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=aiassistant_local


# ─────────────────────────────────────────────────────────────────────────────
# REDIS  (Docker service "redis")
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.yml overrides REDIS_URL inside containers to use the Docker
# service name.  The value below is only used when running uvicorn/celery
# outside Docker (e.g. in a local venv).

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ─────────────────────────────────────────────────────────────────────────────
# CHROMADB  (Docker service "chromadb")
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose.yml overrides CHROMA_HOST=chromadb inside containers.
# Values below are used for out-of-container access (venv / smoke tests run
# on the host).

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false


# ─────────────────────────────────────────────────────────────────────────────
# MINIO  (Docker service "minio", S3-compatible object storage)
# ─────────────────────────────────────────────────────────────────────────────

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=aiassistant-local
STORAGE_BACKEND=minio


# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] JWT signing secret.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_ME_generate_with_python_secrets_token_hex_32

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30


# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] AES-256 key for encrypting API keys stored in the database.
# The backend refuses to start if this is missing or empty (Requirement 26.5).
# Generate with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AES_ENCRYPTION_KEY=REPLACE_ME_generate_with_python_base64_os_urandom_32


# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER API KEYS  [OPTIONAL — leave blank for stub/offline mode]
# ─────────────────────────────────────────────────────────────────────────────
# All non-LLM features (document upload, RAG retrieval, MCP tools, Agent
# orchestration routing) work without any API key.
# Only LLM-generation endpoints (chat, RAG answer synthesis) require a key.

# Google Gemini — recommended for local development.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# Local Ollama (optional — for fully offline/on-device LLM)
OLLAMA_BASE_URL=http://host.docker.internal:11434

GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_ENABLE_FALLBACK=true
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRY_ATTEMPTS=3
LLM_LOG_PROMPTS=false


# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT / LOGGING
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Allow requests from common local development origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://10.0.2.2:8000","http://10.0.2.2:8080"]
ALLOWED_HOSTS=["*"]


# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING  (relaxed for local development)
# ─────────────────────────────────────────────────────────────────────────────

RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_UNAUTH_REQUESTS_PER_MINUTE=200
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=10
ACCOUNT_LOCKOUT_WINDOW_MINUTES=10
ACCOUNT_LOCKOUT_DURATION_MINUTES=5
BCRYPT_WORK_FACTOR=10


# ─────────────────────────────────────────────────────────────────────────────
# RAG SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

MAX_FILE_SIZE_MB=50
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5


# ─────────────────────────────────────────────────────────────────────────────
# AGENT EXECUTION LIMITS
# ─────────────────────────────────────────────────────────────────────────────

MAX_AGENT_STEPS=10
MAX_AGENT_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=120.0


# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY  (disabled for simpler local logs)
# ─────────────────────────────────────────────────────────────────────────────

PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-assistant-backend-local
OTEL_EXPORTER_OTLP_ENDPOINT=
LOKI_URL=


# ─────────────────────────────────────────────────────────────────────────────
# SMTP  (use Mailhog when running docker-compose.dev.yml)
# ─────────────────────────────────────────────────────────────────────────────

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@local.dev


# ─────────────────────────────────────────────────────────────────────────────
# DIFFERENTIAL PRIVACY
# ─────────────────────────────────────────────────────────────────────────────

DP_EPSILON=1.0


# ─────────────────────────────────────────────────────────────────────────────
# MCP TOOL CONNECTORS  [OPTIONAL — leave blank to disable each connector]
# ─────────────────────────────────────────────────────────────────────────────
# The DemoMCPConnector (app/mcp/connectors/demo.py) works with no credentials.
# Real connectors require the credentials shown below.

GITHUB_TOKEN=
SLACK_BOT_TOKEN=
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
NOTION_TOKEN=
FIGMA_ACCESS_TOKEN=

# Atlassian Remote MCP Server (optional — requires developer.atlassian.com app)
ATLASSIAN_MCP_SERVER_URL=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_MCP_TIMEOUT_S=20.0


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH2  [OPTIONAL — only needed if Google sign-in is tested locally]
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE  [OPTIONAL — only needed if push notifications are tested locally]
# ─────────────────────────────────────────────────────────────────────────────

FIREBASE_CREDENTIALS_PATH=
FIREBASE_REMOTE_CONFIG_ENABLED=false
