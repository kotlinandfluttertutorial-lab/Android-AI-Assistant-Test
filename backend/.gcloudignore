# Cloud Build ignore file — keeps the source upload small.
# Only the files needed to build the Docker image are sent to GCS.

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/

# Virtual environments (any venv directory)
.venv/
venv/
venv*/
env/
.env.local

# Test artifacts
.coverage
htmlcov/
.hypothesis/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Docker build artifacts
*.dockerignore

# Local secrets (never upload)
.env
secrets/

# Large ML model weight files (not the app/models/ Python package)
*.bin
*.pt
*.ckpt
*.safetensors
# Exclude top-level models/ dir (ML weights) but NOT app/models/ (ORM package)
/models/

# Logs
*.log
logs/
