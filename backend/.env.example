# ============================================================================
# Android AI Assistant — Backend environment configuration
# ============================================================================
#
# Copy this file to .env and fill in the values for your environment:
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains real secrets.
# This file (.env.example) ONLY contains placeholder / example values.
#
# Variables marked [REQUIRED] have no default and MUST be set.
# Variables marked [OPTIONAL] have sensible defaults shown below.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# DATABASE / CACHE
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL async connection URL (asyncpg driver).
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>

#DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aiassistant
DATABASE_URL=postgresql+asyncpg://aiassistant:aiassistant@localhost:5432/aiassistant

# [REQUIRED] Redis connection URL used for caching, rate limiting, and as the
# default Celery broker and result backend.
# Format: redis://[:<password>@]<host>:<port>/<db-number>
REDIS_URL=redis://localhost:6379/0


# ──────────────────────────────────────────────────────────────────────────────
# JWT / AUTHENTICATION
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Cryptographically random secret key used to sign JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Minimum recommended length: 64 hex characters (32 bytes of entropy).
SECRET_KEY=your-secret-key-here-replace-with-a-real-random-value

# [OPTIONAL] JWT signing algorithm. Default: HS256
JWT_ALGORITHM=HS256

# [OPTIONAL] Lifetime of an access token in minutes. Default: 15
ACCESS_TOKEN_EXPIRE_MINUTES=15

# [OPTIONAL] Lifetime of a refresh token in days. Default: 30
REFRESH_TOKEN_EXPIRE_DAYS=30


# ──────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER API KEYS
# ──────────────────────────────────────────────────────────────────────────────
# Leave blank to disable the corresponding provider.

# [OPTIONAL] OpenAI API key for GPT-4o and other OpenAI models.
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [OPTIONAL] Google Gemini API key for Gemini 1.5 Pro and other Gemini models.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Anthropic API key for Claude 3.5 Sonnet and other Claude models.
# Obtain from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# [OPTIONAL] Base URL of a locally running Ollama server.
# Used for self-hosted Llama 3.x, Mistral, and other open-weight models.
OLLAMA_BASE_URL=http://localhost:11434


# ──────────────────────────────────────────────────────────────────────────────
# VECTOR STORE (ChromaDB)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Hostname of the ChromaDB server. Default: chromadb
CHROMA_HOST=chromadb

# [OPTIONAL] HTTP port of the ChromaDB server. Default: 8001
CHROMA_PORT=8001


# ──────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE (MinIO / S3-compatible)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] MinIO server endpoint in host:port format (no scheme).
# For AWS S3, use: s3.amazonaws.com (and configure access key / secret below).
MINIO_ENDPOINT=localhost:9000

# [OPTIONAL] MinIO access key (username). Leave blank when using IAM roles.
MINIO_ACCESS_KEY=

# [OPTIONAL] MinIO secret key (password). Keep this value secret.
MINIO_SECRET_KEY=

# [OPTIONAL] Name of the MinIO bucket where uploaded documents are stored.
# The bucket is created automatically on first run if it does not exist.
MINIO_BUCKET_NAME=documents


# ──────────────────────────────────────────────────────────────────────────────
# FIREBASE
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Path to the Firebase service account JSON credentials file.
# Required for push notifications and Firebase Remote Config.
# Obtain from: Firebase Console → Project settings → Service accounts.
FIREBASE_CREDENTIALS_PATH=

# [OPTIONAL] Enable Firebase Remote Config feature flags. Default: false
FIREBASE_REMOTE_CONFIG_ENABLED=false


# ──────────────────────────────────────────────────────────────────────────────
# CORS / HOST SECURITY
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Comma-separated list of allowed CORS origins (JSON array syntax).
# In production replace with your exact frontend URL(s).
# Example: ["https://app.example.com","https://admin.example.com"]
CORS_ORIGINS=["http://localhost:3000"]

# [OPTIONAL] Allowed Host header values (JSON array syntax).
# In production set to your API domain(s), e.g. ["api.example.com"].
ALLOWED_HOSTS=["*"]


# ──────────────────────────────────────────────────────────────────────────────
# FILE / RAG SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Maximum file size in megabytes accepted by the upload endpoint.
# Files larger than this limit are rejected with HTTP 413. Default: 50
MAX_FILE_SIZE_MB=50

# [OPTIONAL] Token chunk size used when splitting documents for RAG ingestion.
# Larger chunks preserve more context; smaller chunks allow finer retrieval.
# Default: 512
RAG_CHUNK_SIZE=512

# [OPTIONAL] Token overlap between consecutive RAG chunks.
# Overlap helps prevent boundary information loss. Default: 64
RAG_CHUNK_OVERLAP=64

# [OPTIONAL] Number of top-K chunks retrieved from ChromaDB per RAG query.
# Higher values include more context but increase prompt token usage. Default: 5
RAG_TOP_K=5


# ──────────────────────────────────────────────────────────────────────────────
# RATE LIMITING / ACCOUNT LOCKOUT
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Maximum requests an authenticated user may make per minute. Default: 60
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# [OPTIONAL] Failed login attempts before the account is temporarily locked. Default: 5
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5

# [OPTIONAL] Sliding window (in minutes) for counting failed login attempts. Default: 10
ACCOUNT_LOCKOUT_WINDOW_MINUTES=10

# [OPTIONAL] Duration (in minutes) that an account stays locked. Default: 15
ACCOUNT_LOCKOUT_DURATION_MINUTES=15


# ──────────────────────────────────────────────────────────────────────────────
# CELERY (task queue)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Celery broker URL. Defaults to REDIS_URL when left blank.
# Override if you want a dedicated Redis database or a different broker (e.g. RabbitMQ).
CELERY_BROKER_URL=

# [OPTIONAL] Celery result backend URL. Defaults to REDIS_URL when left blank.
CELERY_RESULT_BACKEND=


# ──────────────────────────────────────────────────────────────────────────────
# LOGGING / ENVIRONMENT
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Python logging level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
LOG_LEVEL=INFO

# [OPTIONAL] Deployment environment. One of: development, staging, production.
# Controls security-sensitive defaults (HTTPS cookies, debug mode, etc.). Default: development
ENVIRONMENT=development


# ──────────────────────────────────────────────────────────────────────────────
# ENCRYPTION
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Base64-encoded AES-256 key used to encrypt API keys and secrets stored in the
# database at rest. The service will REFUSE to start if this variable is absent or empty
# (Requirement 26.5).
# Generate with:  python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AES_ENCRYPTION_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# SMTP (transactional email)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] SMTP server hostname. Leave blank to disable email sending.
# Example: smtp.sendgrid.net
SMTP_HOST=

# [OPTIONAL] SMTP server port. Default: 587 (STARTTLS)
SMTP_PORT=587

# [OPTIONAL] SMTP username or API key.
SMTP_USER=

# [OPTIONAL] SMTP password or API key. Keep this value secret.
SMTP_PASSWORD=

# [OPTIONAL] "From" address for all outgoing transactional emails.
# Default: noreply@example.com
SMTP_FROM_EMAIL=noreply@example.com


# ──────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH2
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Google OAuth2 client ID. Required for Google sign-in.
# Obtain from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

# [OPTIONAL] Google OAuth2 client secret. Keep this value secret.
GOOGLE_CLIENT_SECRET=


# ──────────────────────────────────────────────────────────────────────────────
# SECURITY HARDENING
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] bcrypt cost factor (work factor / rounds).
# Higher = slower to hash but more resistant to brute force. Default: 12
# Use 14+ for high-security / compliance environments.
BCRYPT_WORK_FACTOR=12


# ──────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Expose Prometheus metrics at /metrics. Default: true
PROMETHEUS_ENABLED=true

# [OPTIONAL] Grafana Loki push endpoint for structured log shipping.
# Example: http://loki:3100/loki/api/v1/push
# Leave blank to disable Loki log shipping.
LOKI_URL=


# ──────────────────────────────────────────────────────────────────────────────
# MCP TOOL CONNECTOR CREDENTIALS
# ──────────────────────────────────────────────────────────────────────────────
# Leave blank to disable the corresponding MCP tool connector.

# [OPTIONAL] GitHub personal access token or OAuth token for the MCP GitHub connector.
# Obtain from: https://github.com/settings/tokens
GITHUB_TOKEN=

# [OPTIONAL] Path to Google OAuth2 credentials JSON for the Gmail MCP connector.
# Obtain from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GMAIL_CREDENTIALS_PATH=

# [OPTIONAL] Path to Google OAuth2 credentials JSON for the Google Drive MCP connector.
# Leave blank to reuse GMAIL_CREDENTIALS_PATH.
GDRIVE_CREDENTIALS_PATH=

# [OPTIONAL] Path to Google OAuth2 credentials JSON for the Google Calendar MCP connector.
GCAL_CREDENTIALS_PATH=

# [OPTIONAL] Slack bot OAuth token (xoxb-...) for the MCP Slack connector.
# Obtain from: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=

# [OPTIONAL] Jira Cloud base URL for the MCP Jira connector.
# Example: https://yourorg.atlassian.net
JIRA_BASE_URL=

# [OPTIONAL] Jira account email for Basic Auth.
JIRA_USER_EMAIL=

# [OPTIONAL] Jira API token for Basic Auth.
# Obtain from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# [OPTIONAL] Notion integration secret token for the MCP Notion connector.
# Obtain from: https://www.notion.so/my-integrations
NOTION_TOKEN=

# [OPTIONAL] Figma personal access token for the MCP Figma connector.
# Obtain from: Figma → Settings → Account → Personal access tokens
FIGMA_ACCESS_TOKEN=


# ──────────────────────────────────────────────────────────────────────────────
# DIFFERENTIAL PRIVACY
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Default epsilon (ε) for the Laplace differential-privacy mechanism
# applied to memory embeddings before they are written to ChromaDB.
# Smaller values provide stronger privacy; larger values preserve more utility.
# Valid range: 0.1 (strong privacy) to 10.0 (high utility). Default: 1.0
# Can be overridden at runtime via PUT /admin/privacy/epsilon (stored in Redis).
# Requirements: 37.1, 37.8
DP_EPSILON=1.0


# ──────────────────────────────────────────────────────────────────────────────
# LLM FALLBACK / ORCHESTRATION (Requirement 26.6)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] LLM fallback provider — wired to AI Orchestrator fallback logic
# (Requirement 26.6). When the primary provider fails, the orchestrator automatically
# retries with this provider and notifies the user. When absent or empty, the
# orchestrator returns a structured error instead of attempting a fallback.
# One of: openai, gemini, claude, ollama, llama, mistral
LLM_FALLBACK_PROVIDER=


# ──────────────────────────────────────────────────────────────────────────────
# LLM PER-PROVIDER MAXIMUM OUTPUT TOKENS (Requirement 25.5)
# ──────────────────────────────────────────────────────────────────────────────
# These caps prevent runaway generation costs. The orchestrator clamps every
# LLM request to min(requested_max_tokens, configured_max) before sending.
# Set to 0 to disable the cap for a specific provider (not recommended).

# [OPTIONAL] Max output tokens for OpenAI GPT-4o. Default: 4096
LLM_MAX_OUTPUT_TOKENS_OPENAI=4096

# [OPTIONAL] Max output tokens for Google Gemini 1.5 Pro. Default: 8192
LLM_MAX_OUTPUT_TOKENS_GEMINI=8192

# [OPTIONAL] Max output tokens for Anthropic Claude 3.5 Sonnet. Default: 8192
LLM_MAX_OUTPUT_TOKENS_CLAUDE=8192

# [OPTIONAL] Max output tokens for self-hosted Ollama models. Default: 2048
LLM_MAX_OUTPUT_TOKENS_OLLAMA=2048

# [OPTIONAL] Max output tokens for Llama 3.x via local Ollama. Default: 2048
LLM_MAX_OUTPUT_TOKENS_LLAMA=2048

# [OPTIONAL] Max output tokens for Mistral via local Ollama. Default: 2048
LLM_MAX_OUTPUT_TOKENS_MISTRAL=2048


# ──────────────────────────────────────────────────────────────────────────────
# UNAUTHENTICATED RATE LIMITING (Requirement 9.11)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Maximum requests an unauthenticated source IP may make per minute.
# Applied to all public (unauthenticated) HTTP requests as a second-tier rate limit.
# Default: 20
RATE_LIMIT_UNAUTH_REQUESTS_PER_MINUTE=20


# ──────────────────────────────────────────────────────────────────────────────
# REQUEST BODY SIZE LIMIT (Requirement 9.x)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Maximum allowed request body size in bytes for JSON endpoints.
# Oversized bodies are rejected with HTTP 413 before schema validation.
# File upload endpoints (/documents/upload) are exempt; they use MAX_FILE_SIZE_MB.
# Default: 1048576 (1 MiB)
MAX_REQUEST_BODY_SIZE=1048576


# ──────────────────────────────────────────────────────────────────────────────
# DATA RESIDENCY (Requirement 9.7)
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Geographic region for data residency enforcement.
# When non-empty, write operations (POST, PUT, PATCH, DELETE) are rejected with
# HTTP 403 if the X-Client-Region request header is present and does not match.
# Leave blank to disable data residency enforcement.
# Example: eu-west-1
DATA_RESIDENCY_REGION=
