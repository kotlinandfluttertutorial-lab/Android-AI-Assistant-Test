# ============================================================================
# Android AI Assistant — Root-level environment reference
# ============================================================================
#
# This file documents environment variables that apply at the repository root
# (e.g. those consumed by CI scripts in .github/scripts/).
#
# Backend-specific variables are documented in backend/.env.example.
#
# NEVER commit .env to version control — it contains real secrets.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# TLS CERTIFICATE PINNING (Requirement 28.7)
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED for production] SHA-256 SPKI fingerprint of the backend TLS certificate.
# Must match the primary <pin digest="SHA-256"> value in
# app/src/main/res/xml/network_security_config.xml.
#
# Generate from a PEM certificate:
#   openssl x509 -in cert.pem -pubkey -noout \
#     | openssl pkey -pubin -outform DER \
#     | openssl dgst -sha256 -binary \
#     | base64
#
# Both this value and the XML pin MUST be updated atomically during certificate
# rotation (Requirement 28.7).
# PLACEHOLDER — replace with the real SPKI fingerprint before production release.
BACKEND_TLS_PIN_SHA256=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
