<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — Material3 via Compose; AppCompat-compatible parent
         required for third-party views that extend AppCompatTextView (e.g. compose-markdown). -->
    <style name="Theme.AIAssistant" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Splash screen theme using AndroidX SplashScreen API (windowSplashScreenBackground). -->
    <style name="Theme.AIAssistant.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AIAssistant</item>
    </style>
</resources>
