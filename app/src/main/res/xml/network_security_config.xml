<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  ================================
  Requirement 28.7: Pin the backend TLS certificate so the app rejects
  connections to servers presenting an untrusted certificate.

  Certificate Rotation Procedure:
  1. Obtain the new certificate's SHA-256 SPKI fingerprint:
       openssl x509 -in new-cert.pem -pubkey -noout \
         | openssl pkey -pubin -outform DER \
         | openssl dgst -sha256 -binary \
         | base64
  2. Update the <pin> value below (keep the backup pin pointing to the
     intermediate CA or the next certificate to allow zero-downtime rotation).
  3. Update BACKEND_TLS_PIN_SHA256 in .env.example to match the primary pin.
  4. Deploy the new backend certificate AND this updated APK in the same
     release window. Do NOT rotate the certificate before shipping the APK.
-->
<network-security-config>

    <!--
      Production backend domain — TLS required, certificate pinned.
      Replace "api.example.com" with the actual production backend FQDN.
      Replace the pin value with the real SPKI SHA-256 fingerprint obtained
      via the rotation procedure above.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.example.com</domain>
        <pin-set expiration="2026-01-01">
            <!--
              Primary pin: SHA-256 fingerprint of the backend TLS certificate's
              Subject Public Key Info (SPKI).
              PLACEHOLDER — replace before production release.
              Must match BACKEND_TLS_PIN_SHA256 in .env.example.
            -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!--
              Backup pin: SHA-256 fingerprint of the intermediate CA or the
              next leaf certificate (enables zero-downtime rotation).
              PLACEHOLDER — replace before production release.
            -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
    </domain-config>

    <!-- Allow cleartext HTTP to local development backend addresses only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.158</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- All other connections require TLS (production default). -->
    <base-config cleartextTrafficPermitted="false" />

</network-security-config>
