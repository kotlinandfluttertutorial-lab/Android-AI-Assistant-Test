<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules — controls which files are backed up via cloud backup
    and which are shared via Content Capture.

    See: https://developer.android.com/guide/topics/data/autobackup#define-xml
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all EncryptedSharedPreferences files (security requirement 9.4) -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude DataStore preferences (tokens, settings) -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
